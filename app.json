{
  "expo": {
    "name": "LpgCalculator",
    "slug": "LpgCalculator",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/fonts/NotoNastaliqUrdu-Regular.ttf",
      "assets/icon.png",
      "assets/splash.png",
      "assets/adaptive-icon.png",
      "assets/logo.jpeg",
      "assets/app-icon.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "globalenergyservice.lpg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "globalenergyservice.lpg",
      "versionCode": 4,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      }
    },
    "plugins": [
      "expo-localization",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "ff16455f-13f3-4f67-81c8-2ea81feff61a"
      }
    }
  }
}
